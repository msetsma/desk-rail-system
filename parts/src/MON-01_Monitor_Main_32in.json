      "-m32u_h/2 - m32u_vesa_dz + m32u_port_z"
     ],
     [
      "m32u_pkt_wb/2 + 0.05 mm",
      "-m32u_h/2 - m32u_vesa_dz - 0.1 mm"
     ],
     [
      "-m32u_pkt_wb/2 - 0.05 mm",
      "-m32u_h/2 - m32u_vesa_dz - 0.1 mm"
     ]
    ],
    "closed": true
   }
  },
  {
