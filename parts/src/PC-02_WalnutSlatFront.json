      "-(pc_h/2 - pc_bezel_v)"
     ],
     [
      "-pc_w/2 + pc_bezel + slat_gap + slat_w",
      "pc_h/2 - pcn_foot_h - pc_bezel_v"
     ],
     [
      "-pc_w/2 + pc_bezel + slat_gap",
      "pc_h/2 - pcn_foot_h - pc_bezel_v"
     ]
    ]
   }
  },
  {
