      -107.5,
      4.5,
      223.5
     ],
     [
      107.5,
      4.5,
      223.5
     ],
     [
      -107.5,
      4.5,
      -204.5
     ],
     [
      107.5,
      4.5,
      -204.5
     ]
    ]
   }
  },
  {
   "command": "solid.box",
   "params": {
    "name": "PC02_FrameOpening",
    "operation": "cut",
    "targets": [
     "PC_FrontFrame"
    ],
    "length": "pc_w - 2*pcn_lip",
    "width": "slat_inset + slat_t + 0.1 mm",
    "height": "(pc_h - pcn_foot_h) - 2*pcn_lip",
    "corner": [
     "-pc_w/2 + pcn_lip",
     "-slat_inset - 0.1 mm",
     "-pc_h/2 + pcn_foot_h + pcn_lip"
    ]
   }
  },
  {
   "command": "solid.box",
   "params": {
    "name": "PC02_FrameBackOpening",
    "operation": "cut",
    "targets": [
     "PC_FrontFrame"
    ],
    "length": "pc_w - 2*pcn_lip",
    "width": "3.2 mm",
    "height": "(pc_h - pcn_foot_h) - 2*pc_bezel_v - 16 mm",
    "corner": [
     "-pc_w/2 + pcn_lip",
     "slat_t - 0.1 mm",
     "-pc_h/2 + pcn_foot_h + pc_bezel_v + 8 mm"
    ]
   }
  },
  {
   "command": "sketch.create",
   "params": {
