   }
  },
  {
   "command": "solid.box",
   "params": {
    "name": "PC02_Frame",
    "body_name": "PC_FrontFrame",
    "operation": "new",
    "length": "pc_w",
    "width": "pcn_frame_d",
    "height": "(pc_h - pcn_foot_h)",
    "corner": [
     "-pc_w/2",
     "-slat_inset",
     "-pc_h/2 + pcn_foot_h"
    ]
   }
  },
  {
   "command": "solid.fillet",
   "params": {
    "name": "PC02_FrameEdgeRound",
    "radius": "pcn_edge_r",
    "edges": [
